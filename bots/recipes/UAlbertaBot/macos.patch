diff -ruN a/UAlbertaBot/Source/UAlbertaBotAIModule.h b/UAlbertaBot/Source/UAlbertaBotAIModule.h
--- a/UAlbertaBot/Source/UAlbertaBotAIModule.h	1969-12-31 19:00:00
+++ b/UAlbertaBot/Source/UAlbertaBotAIModule.h	2026-10-07 22:02:29
@@ -0,0 +1,43 @@
+#pragma once
+
+// Added for Stardust's test harness, which loads bots as BWAPI AIModules: UAlbertaBot's own module is a plain class
+// driven by the client loop in main.cpp, so this forwards the AIModule events to it the same way main.cpp does.
+
+#include <memory>
+
+#include "UAlbertaBotModule.h"
+#include "../../SparCraft/source/SparCraft.h"
+#include "../../BOSS/source/BOSS.h"
+
+class UAlbertaBotAIModule : public BWAPI::AIModule
+{
+    std::unique_ptr<UAlbertaBot::UAlbertaBotModule> bot;
+
+public:
+    // Made here rather than in a constructor because it reads the game as it is built
+    void onStart() override
+    {
+        // main.cpp sets up the combat simulator and build-order search once, before its first game
+        static bool initialized = false;
+        if (!initialized)
+        {
+            SparCraft::init();
+            BOSS::init();
+            initialized = true;
+        }
+
+        bot = std::make_unique<UAlbertaBot::UAlbertaBotModule>();
+        bot->onStart();
+    }
+
+    void onFrame() override { bot->onFrame(); }
+    void onEnd(bool isWinner) override { bot->onEnd(isWinner); }
+    void onUnitShow(BWAPI::Unit unit) override { bot->onUnitShow(unit); }
+    void onUnitHide(BWAPI::Unit unit) override { bot->onUnitHide(unit); }
+    void onUnitCreate(BWAPI::Unit unit) override { bot->onUnitCreate(unit); }
+    void onUnitMorph(BWAPI::Unit unit) override { bot->onUnitMorph(unit); }
+    void onUnitDestroy(BWAPI::Unit unit) override { bot->onUnitDestroy(unit); }
+    void onUnitRenegade(BWAPI::Unit unit) override { bot->onUnitRenegade(unit); }
+    void onUnitComplete(BWAPI::Unit unit) override { bot->onUnitComplete(unit); }
+    void onSendText(std::string text) override { bot->onSendText(text); }
+};
