class UpgradeType:
    def __init__(self, id: int = ...) -> None: ...
    def getID(self) -> int: ...
    def getName(self) -> str: ...
    def toString(self) -> str: ...
    def isValid(self) -> bool: ...
    @staticmethod
    def getType(name: str) -> UpgradeType:
        """Look up by name, ignoring case, spaces and underscores."""
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...
    def __lt__(self, other: UpgradeType) -> bool: ...
    def __hash__(self) -> int: ...
    def getRace(self) -> Race:
        """Retrieves the race the upgrade is for. For example, UpgradeTypes::Terran_Infantry_Armor.getRace() will return Races::Terran."""
    def mineralPrice(self, level: int = ...) -> int:
        """Returns the mineral price for the upgrade."""
    def mineralPriceFactor(self) -> int:
        """The amount that the mineral price increases for each additional upgrade."""
    def gasPrice(self, level: int = ...) -> int:
        """Returns the vespene gas price for the first upgrade."""
    def gasPriceFactor(self) -> int:
        """Returns the amount that the vespene gas price increases for each additional upgrade."""
    def upgradeTime(self, level: int = ...) -> int:
        """Returns the number of frames needed to research the first upgrade."""
    def upgradeTimeFactor(self) -> int:
        """Returns the number of frames that the upgrade time increases for each additional upgrade."""
    def maxRepeats(self) -> int:
        """Returns the maximum number of times the upgrade can be researched."""
    def whatUpgrades(self) -> UnitType:
        """Returns the type of unit that researches the upgrade."""
